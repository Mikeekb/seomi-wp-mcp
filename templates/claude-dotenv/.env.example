# ─────────────────────────────────────────────────────────────────────
# AI agent credentials for this project (managed by @seomi/wp-mcp).
# This file is GITIGNORED — secrets stay out of the repo.
# Re-run `seomi-wp-mcp init` to refresh values; unrelated keys are preserved.
# ─────────────────────────────────────────────────────────────────────

# ── WordPress: LOCAL ──
WP_LOCAL_URL=https://localhost
WP_LOCAL_USER=ai-agent
WP_LOCAL_APP_PASSWORD=
WP_LOCAL_MCP_SERVER=wordpress-local

# ── WordPress: PRODUCTION (optional) ──
WP_PROD_URL=
WP_PROD_USER=ai-agent
WP_PROD_APP_PASSWORD=
WP_PROD_MCP_SERVER=wordpress-prod

# ── SSH to prod (used by the prod MCP server and remote plugin install) ──
# Required only if you want a prod MCP server / install plugins on prod.
WP_PROD_SSH_HOST=
WP_PROD_SSH_USER=ai-agent
WP_PROD_SSH_PORT=        # blank = default 22
WP_PROD_WP_ROOT=         # absolute path on prod, e.g. /home/user/site/public_html

# ── WP-CLI phar path (auto-detected by `init`, written here for `doctor --fix`) ──
WP_CLI_PHAR=

# ── Plugin-dep pinning (optional) ──
# WP_DEPS_REF=trunk   # or a specific tag like "1.0.0"
